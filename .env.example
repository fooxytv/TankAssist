# TankAssist Development Environment Configuration
# Copy this file to .env and update the paths for your system

# Retail WoW addon directory (main development target)
wow_addons_dir_retail=/c/Program Files (x86)/World of Warcraft/_retail_/Interface/AddOns

# PTR addon directory (for testing on Public Test Realm)
wow_addons_dir_ptr=/c/Program Files (x86)/World of Warcraft/_ptr_/Interface/AddOns

# CurseForge API token (optional, for automated uploads)
# Get your token from: https://authors.curseforge.com/account/api-tokens
# curseforge_api_token=your_token_here

# CurseForge project ID (optional, for automated uploads)
# curseforge_project_id=your_project_id

# Anthropic API key (optional, for auto-generating changelogs with Claude)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_api_key_here
